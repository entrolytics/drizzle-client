{
  "name": "@entrolytics/drizzle-client",
  "version": "2.2.2",
  "description": "Drizzle ORM client for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "database",
    "drizzle",
    "entrolytics",
    "neon",
    "orm",
    "postgres",
    "serverless"
  ],
  "homepage": "https://github.com/entrolytics/drizzle-client",
  "bugs": {
    "url": "https://github.com/entrolytics/drizzle-client/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.click>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/drizzle-client.git",
    "directory": "drizzle-client"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp lint --fix . && vp fmt --write .",
    "dev": "vp pack --watch",
    "format": "vp fmt --write .",
    "lint": "vp lint --fix --fix-suggestions . && vp fmt --write .",
    "lint:fix-unsafe": "vp lint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously .",
    "test": "vp test run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "debug": "^4.4.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "typescript": "^6.0.3",
    "vite": "^8.0.15",
    "vite-plus": "^0.1.23",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.4-5d5b77c"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=24.x"
  },
  "packageManager": "pnpm@11.5.0"
}
