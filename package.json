{
  "name": "@entrolytics/drizzle-client",
  "version": "3.0.2",
  "description": "Drizzle ORM client for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "database",
    "drizzle",
    "entrolytics",
    "neon",
    "orm",
    "postgres",
    "serverless"
  ],
  "homepage": "https://github.com/entrolytics/drizzle-client",
  "bugs": {
    "url": "https://github.com/entrolytics/drizzle-client/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/drizzle-client.git",
    "directory": "drizzle-client"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --noEmit false",
    "check": "oxlint --fix . && oxfmt --write .",
    "dev": "tsdown --watch",
    "format": "oxfmt --write .",
    "lint": "oxlint --fix --fix-suggestions . && oxfmt --write .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "debug": "^4.4.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "rc",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsdown": "^0.23.7",
    "typescript": "next",
    "vitest": "^5.1.2"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.6"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=24.22.3"
  },
  "packageManager": "pnpm@12.23.0"
}
